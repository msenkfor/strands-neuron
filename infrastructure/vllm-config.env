# vLLM Neuron Server Configuration
# Copy this file and customize for your deployment

# =============================================================================
# Core Configuration (Required)
# =============================================================================
MODEL=meta-llama/Llama-3.1-8B-Instruct
PORT=8080

# =============================================================================
# Model Configuration
# =============================================================================
MAX_NUM_SEQS=4
MAX_MODEL_LEN=1024
TENSOR_PARALLEL_SIZE=8

# =============================================================================
# Tool Calling Configuration
# =============================================================================
# Enable tool calling support (true/false)
ENABLE_TOOL_CALLING=true

# Tool parser options:
# - llama3_json: For Llama 3.1+ models (supports single tool calls)
# - hermes: For Hermes models
# - mistral: For Mistral models
# - pythonic: For models with Pythonic parser (supports parallel calls)
# See: https://docs.vllm.ai/en/latest/features/tool_calling/
TOOL_CALL_PARSER=llama3_json

# =============================================================================
# Performance Configuration
# =============================================================================
# Prefix caching can improve performance for repeated prompts (true/false)
ENABLE_PREFIX_CACHING=false

# Device type (neuron for AWS Neuron hardware)
DEVICE=neuron

# =============================================================================
# Advanced Neuron Configuration
# =============================================================================
# Override neuron-specific config (JSON format)
# Example: {"override_neuron_config":{"enable_bucketing":false}}
OVERRIDE_NEURON_CONFIG='{"override_neuron_config":{"enable_bucketing":false}}'

# =============================================================================
# Speculative Decoding (Optional - Advanced)
# =============================================================================
# Enable speculative decoding for improved latency (true/false)
ENABLE_SPECULATIVE=false
SPECULATIVE_MAX_MODEL_LEN=1024

# =============================================================================
# KV Cache Transfer (Optional - For Distributed Setups)
# =============================================================================
# Enable KV cache transfer between instances (true/false)
ENABLE_KV_TRANSFER=false
KV_CONNECTOR=NeuronConnector
KV_ROLE=kv_producer
KV_BUFFER_SIZE=2e11
# etcd address for coordination (required if KV_TRANSFER is enabled)
ETCD=
