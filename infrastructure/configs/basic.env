# Basic Configuration - Simple deployment without tool calling
# Good for: Text generation, chat, basic inference

MODEL=mistralai/Mistral-7B-Instruct-v0.3
PORT=8080
MAX_NUM_SEQS=4
MAX_MODEL_LEN=2048
TENSOR_PARALLEL_SIZE=8

# Disable tool calling for simplicity
ENABLE_TOOL_CALLING=false
ENABLE_PREFIX_CACHING=false
DEVICE=neuron
OVERRIDE_NEURON_CONFIG='{"override_neuron_config":{"enable_bucketing":false}}'
