# Distributed KV Consumer (Decode Worker)
MODEL=meta-llama/Llama-3.3-70B-Instruct
PORT=8082
MAX_NUM_SEQS=8
MAX_MODEL_LEN=8192
TENSOR_PARALLEL_SIZE=16
# Restrict to physical NeuronCores 32-63 so prefill can use 0-31
NEURON_RT_VISIBLE_CORES=32-63

# Tool calling
ENABLE_TOOL_CALLING=true
TOOL_CALL_PARSER=llama3_json

# Performance
ENABLE_PREFIX_CACHING=false
DEVICE=neuron
OVERRIDE_NEURON_CONFIG='{}'
VLLM_USE_V1=0
# Must match PORT so NeuronConnector computes ZMQ port correctly
API_SERVER_PORT=8082
# Bootstrap port for Neuron async EFA send/recv (must be unique per worker on same host)
NEURON_RT_ASYNC_SENDRECV_BOOTSTRAP_PORT=11000
NEURON_RT_ASYNC_SENDRECV_EXPERIMENTAL_ENABLED=1

# KV cache transfer between instances
ENABLE_KV_TRANSFER=true
KV_CONNECTOR=NeuronConnector
KV_ROLE=kv_consumer
KV_BUFFER_SIZE=2e11
KV_NEURON_CORE_OFFSET=32
ETCD=172.31.31.191:8989
