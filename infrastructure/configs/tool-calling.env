# Tool Calling Configuration - Optimized for Strands agents with tools
# Good for: Strands agents, function calling, structured output

MODEL=mistralai/Mistral-7B-Instruct-v0.3
PORT=8080
MAX_NUM_SEQS=4
MAX_MODEL_LEN=2048
TENSOR_PARALLEL_SIZE=8

# Enable tool calling with Llama 3 JSON parser
ENABLE_TOOL_CALLING=true
TOOL_CALL_PARSER=llama3_json

# Performance settings
ENABLE_PREFIX_CACHING=false
DEVICE=neuron
OVERRIDE_NEURON_CONFIG='{"override_neuron_config":{"enable_bucketing":false}}'

# Note: Llama 3.1 only supports single tool calls at once
# For parallel tool calls, use Llama 4 or other supported models
