# High Throughput Configuration - Optimized for maximum requests/second
# Good for: Production workloads, high traffic, batch processing

MODEL=meta-llama/Llama-3.1-8B-Instruct
PORT=8080

# Increased batch size for higher throughput
MAX_NUM_SEQS=16
MAX_MODEL_LEN=1024
TENSOR_PARALLEL_SIZE=8

# Enable prefix caching for repeated prompts
ENABLE_TOOL_CALLING=true
TOOL_CALL_PARSER=llama3_json
ENABLE_PREFIX_CACHING=true
DEVICE=neuron
OVERRIDE_NEURON_CONFIG='{"override_neuron_config":{"enable_bucketing":false}}'
