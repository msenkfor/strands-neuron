# Speculative Decoding Configuration for Qwen3-32B with Qwen3-0.6B draft model
# Based on: https://awsdocs-neuron.readthedocs-hosted.com/en/latest/libraries/nxd-inference/developer_guides/speculative_decoding.html

PORT=8080
MAX_NUM_SEQS=1
MAX_MODEL_LEN=6400
TENSOR_PARALLEL_SIZE=64
MODEL=meta-llama/Llama-3.3-70B-Instruct
DRAFT_MODEL_ID=meta-llama/Llama-3.2-1B-Instruct

# Disable tool calling for simplicity
ENABLE_TOOL_CALLING=false
ENABLE_PREFIX_CACHING=false

# Neuron config (passed via --additional-config)
ADDITIONAL_CONFIG='{"override_neuron_config": {"save_sharded_checkpoint": true, "enable_fused_speculation": true}}'

# Speculative decoding config (passed via --speculative-config as separate argument)
SPECULATIVE_CONFIG='{"model": "meta-llama/Llama-3.2-1B-Instruct", "num_speculative_tokens": 7, "max_model_len": 2048, "method": "eagle"}'

# vLLM V1 engine (this version requires V1=1)
VLLM_USE_V1=1
