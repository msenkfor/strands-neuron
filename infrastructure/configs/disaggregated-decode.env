# Disaggregated Inference - Decode Server (kv_consumer)
#
# Usage:
#   ETCD=<proxy-ip>:8989 HF_TOKEN=<token> ./disaggregated/run-decode.sh
#
# ETCD must be set in the environment — it points to your proxy/etcd instance.
# Set NEURON_COMPILED_ARTIFACTS if using pre-compiled model artifacts.

MODEL=meta-llama/Llama-3.3-70B-Instruct
PORT=8000
MAX_NUM_SEQS=8
MAX_MODEL_LEN=8192
TENSOR_PARALLEL_SIZE=64

# Required for disaggregated inference
VLLM_DEVICE=neuron
ENABLE_KV_TRANSFER=true
KV_ROLE=kv_consumer
KV_BUFFER_SIZE=2e11
SPECULATIVE_MAX_MODEL_LEN=8192
OVERRIDE_NEURON_CONFIG={}

# Single-instance only: restrict to second half of NeuronCores
# (comment out for multi-instance — each instance gets all its cores)
# NEURON_RT_VISIBLE_CORES=32-63
